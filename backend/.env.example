# Copy this file to ".env" (in the same backend folder) and change the values.

# Secret used to sign admin login tokens. Use a long random text, e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Address of the website (for CORS). Change it when you deploy.
FRONTEND_URL=http://localhost:5173
